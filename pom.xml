<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>SokkerViewer</groupId>
	<artifactId>SokkerViewer</artifactId>
	<name>SokkerViewer</name>
	<version>0.15.4</version>
	<properties>
		<!-- newest SWT that still starts on Windows 8.1 -->
		<swt.version>3.129.0</swt.version>
		<swt.os-specific-dep>org.eclipse.swt.win32.win32.x86_64</swt.os-specific-dep>
	</properties>
	<repositories>
		<repository>
			<id>central</id>
			<name>Maven Central</name>
			<url>https://repo.maven.apache.org/maven2</url>
		</repository>
		<repository>
			<id>terrestris</id>
			<url>https://nexus.terrestris.de/repository/public/</url>
		</repository>
		<repository>
			<id>htmlentities-repo</id>
			<url>https://sic.ctti.extranet.gencat.cat/nexus/repository/public/</url>
		</repository>
	</repositories>
	<dependencies>
		<dependency>
		  <groupId>org.eclipse.platform</groupId>
		  <artifactId>org.eclipse.swt.win32.win32.x86_64</artifactId>
		  <version>${swt.version}</version>
		</dependency>
		<dependency>
			<groupId>hsqldb</groupId>
			<artifactId>hsqldb</artifactId>
			<version>1.8.1.1</version>
		</dependency>
		<dependency>
			<groupId>com.lowagie</groupId>
			<artifactId>itext</artifactId>
			<version>1.4.8</version>
		</dependency>
		<dependency>
			<groupId>jfree</groupId>
			<artifactId>jcommon</artifactId>
			<version>1.0.0</version>
		</dependency>
		<dependency>
			<groupId>jfree</groupId>
			<artifactId>jfreechart</artifactId>
			<version>1.0.1</version>
		</dependency>
		<dependency>
			<groupId>com.tecnick.htmlutils</groupId>
			<artifactId>htmlentities</artifactId>
			<version>1.0.0</version>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
			<version>2.10.1</version>
		</dependency>
	</dependencies>
	<profiles>
		<profile>
			<id>unix</id>
			<activation>
				<os>
					<family>unix</family>
				</os>
			</activation>
			<properties>
				<swt.os-specific-dep>swt-linux-gtk
				</swt.os-specific-dep>
				<sv.os.type name="os.name.value">linux</sv.os.type>
			</properties>
		</profile>
		<profile>
			<id>windows</id>
			<activation>
				<os>
					<family>windows</family>
				</os>
			</activation>
			<properties>
				<swt.os-specific-dep>org.eclipse.swt.win32.win32.x86_64</swt.os-specific-dep>
				<sv.os.type name="os.name.value">windows</sv.os.type>
			</properties>
		</profile>
		<profile>
			<id>macosx</id>
			<activation>
				<os>
					<family>macosx</family>
				</os>
			</activation>
			<properties>
				<swt.os-specific-dep>swt-macosx</swt.os-specific-dep>
				<sv.os.type name="os.name.value">mac</sv.os.type>
			</properties>
		</profile>
		<profile>
			<id>unix-x86_64</id>
			<properties>
				<swt.os-specific-dep>swt-linux-gtk-x86_64
				</swt.os-specific-dep>
				<sv.os.type name="os.name.value">linux-x86_64</sv.os.type>
			</properties>
		</profile>
		<profile>
			<id>windows-x86_64</id>
			<properties>
				<swt.os-specific-dep>org.eclipse.swt.win32.win32.x86_64</swt.os-specific-dep>
				<sv.os.type name="os.name.value">windows-x86_64</sv.os.type>
			</properties>
		</profile>
		<profile>
			<id>macosx-x86_64</id>
			<properties>
				<swt.os-specific-dep>swt-macosx-x86_64</swt.os-specific-dep>
				<sv.os.type name="os.name.value">mac-x86_64</sv.os.type>
			</properties>
		</profile>
		<profile>
			<!--
				Ready to run bundles for Windows x64 and macOS on Apple silicon: the application,
				a trimmed Java runtime and a launcher, so nothing has to be installed.

				mvn -Pbundle clean verify
				-> packages/release/stable/windows/sokker-${project.version}-win64-with-java.zip
				-> packages/release/stable/macos/sokker-${project.version}-macos-arm64-with-java.zip

				Needs a JDK (not a JRE) as JAVA_HOME, because it runs jlink. The macOS runtime is
				linked from the jmods of the macOS JDK below, which must be the same version as
				JAVA_HOME; it is downloaded once into packages/cache.
				The normal build is not affected by this profile.
			-->
			<id>bundle</id>
			<properties>
				<bundle.windows.dir>${basedir}/packages/bundle/windows/SokkerViewer</bundle.windows.dir>
				<bundle.macos.dir>${basedir}/packages/bundle/macos/SokkerViewer</bundle.macos.dir>
				<bundle.modules>java.base,java.desktop,java.naming,java.sql,jdk.charsets,jdk.crypto.ec,jdk.localedata</bundle.modules>
				<!-- the languages SokkerViewer is translated into, see src/main/resources/lang -->
				<bundle.locales>en,bg,cs,da,de,el,es,et,fr,hu,it,pl,pt,ro,ru,tr,zh</bundle.locales>
				<!-- the jlink options both runtimes are linked with -->
				<bundle.jlink>--add-modules ${bundle.modules} --include-locales=${bundle.locales} --strip-debug --no-header-files --no-man-pages --compress=zip-6</bundle.jlink>
				<!-- the files the macOS zip marks executable -->
				<bundle.macos.programs>SokkerViewer.command,runtime/bin/**,runtime/lib/jspawnhelper</bundle.macos.programs>
				<!-- the macOS JDK, <version>+<build> -->
				<macos.jdk.version>21.0.12.1</macos.jdk.version>
				<macos.jdk.build>1</macos.jdk.build>
				<macos.jdk>OpenJDK21U-jdk_aarch64_mac_hotspot_${macos.jdk.version}_${macos.jdk.build}.tar.gz</macos.jdk>
				<macos.jdk.url>https://github.com/adoptium/temurin21-binaries/releases/download/jdk-${macos.jdk.version}%2B${macos.jdk.build}/${macos.jdk}</macos.jdk.url>
				<macos.jdk.sha256>3623232f33a9c3baadf304480b2535f9a3cba8a58d42ecbb438ba267315d9998</macos.jdk.sha256>
				<macos.jmods>${basedir}/packages/cache/jdk-${macos.jdk.version}+${macos.jdk.build}/Contents/Home/jmods</macos.jmods>
			</properties>
			<build>
				<plugins>
					<plugin>
						<artifactId>maven-dependency-plugin</artifactId>
						<executions>
							<execution>
								<id>bundle-macos-swt</id>
								<phase>process-resources</phase>
								<goals>
									<goal>copy</goal>
								</goals>
								<configuration>
									<artifactItems>
										<artifactItem>
											<groupId>org.eclipse.platform</groupId>
											<artifactId>org.eclipse.swt.cocoa.macosx.aarch64</artifactId>
											<version>${swt.version}</version>
											<destFileName>swt.jar</destFileName>
										</artifactItem>
									</artifactItems>
									<outputDirectory>${project.build.directory}/macos</outputDirectory>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>1.1</version>
						<executions>
							<execution>
								<id>bundle-runtime</id>
								<phase>prepare-package</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<tasks>
										<delete dir="${bundle.windows.dir}" />
										<mkdir dir="${bundle.windows.dir}" />
										<copy todir="${bundle.windows.dir}">
											<!-- cour.ttf is Microsoft's Courier New and may not be redistributed -->
											<fileset dir="${basedir}/packages/windows/sokker" excludes="fonts/cour.ttf" />
										</copy>
										<exec executable="${java.home}/bin/jlink" failonerror="true">
											<arg line="${bundle.jlink}" />
											<arg value="--output" />
											<arg value="${bundle.windows.dir}/runtime" />
										</exec>
									</tasks>
								</configuration>
							</execution>
							<execution>
								<id>bundle-runtime-macos</id>
								<phase>prepare-package</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<tasks>
										<mkdir dir="${basedir}/packages/cache" />
										<!-- an offline build keeps the cached copy -->
										<get src="${macos.jdk.url}" dest="${basedir}/packages/cache/${macos.jdk}" usetimestamp="true" ignoreerrors="true" />
										<checksum file="${basedir}/packages/cache/${macos.jdk}" algorithm="SHA-256"
											property="${macos.jdk.sha256}" verifyproperty="macos.jdk.verified" />
										<fail message="${macos.jdk} does not match its sha-256: delete it from packages/cache and build again">
											<condition>
												<isfalse value="${macos.jdk.verified}" />
											</condition>
										</fail>
										<untar src="${basedir}/packages/cache/${macos.jdk}" dest="${basedir}/packages/cache" compression="gzip">
											<patternset includes="*/Contents/Home/jmods/*.jmod" />
										</untar>
										<fail message="no java.base.jmod in ${macos.jmods}">
											<condition>
												<not>
													<available file="${macos.jmods}/java.base.jmod" />
												</not>
											</condition>
										</fail>
										<delete dir="${bundle.macos.dir}" />
										<mkdir dir="${bundle.macos.dir}" />
										<copy todir="${bundle.macos.dir}">
											<!-- leaves out cour.ttf, the windows icon and the windows swt -->
											<fileset dir="${basedir}/packages/windows/sokker" excludes="fonts/cour.ttf,installSokkerViewer.ico,lib/swt.jar" />
										</copy>
										<copy file="${project.build.directory}/macos/swt.jar" todir="${bundle.macos.dir}/lib" />
										<copy file="${basedir}/src/main/resources/images/sokkerViewer_ico[64x64].png" tofile="${bundle.macos.dir}/SokkerViewer.png" />
										<fixcrlf srcdir="${basedir}/src/main/macos" destdir="${bundle.macos.dir}" includes="SokkerViewer.command" eol="lf" />
										<exec executable="${java.home}/bin/jlink" failonerror="true">
											<arg value="--module-path" />
											<arg value="${macos.jmods}" />
											<arg line="${bundle.jlink}" />
											<arg value="--output" />
											<arg value="${bundle.macos.dir}/runtime" />
										</exec>
									</tasks>
								</configuration>
							</execution>
							<execution>
								<id>bundle-zip</id>
								<phase>verify</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<tasks>
										<zip
											destfile="${basedir}/packages/release/stable/windows/sokker-${project.version}-win64-with-java.zip">
											<zipfileset dir="${bundle.windows.dir}" prefix="SokkerViewer"
												excludes="SokkerViewer.exe" />
											<zipfileset dir="${bundle.windows.dir}" prefix="SokkerViewer"
												includes="SokkerViewer.exe" filemode="755" />
										</zip>
									</tasks>
								</configuration>
							</execution>
							<execution>
								<id>bundle-zip-macos</id>
								<phase>verify</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<tasks>
										<mkdir dir="${basedir}/packages/release/stable/macos" />
										<zip
											destfile="${basedir}/packages/release/stable/macos/sokker-${project.version}-macos-arm64-with-java.zip">
											<zipfileset dir="${bundle.macos.dir}" prefix="SokkerViewer"
												excludes="${bundle.macos.programs}" />
											<zipfileset dir="${bundle.macos.dir}" prefix="SokkerViewer"
												includes="${bundle.macos.programs}" filemode="755" />
										</zip>
									</tasks>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>com.akathist.maven.plugins.launch4j</groupId>
						<artifactId>launch4j-maven-plugin</artifactId>
						<version>2.5.2</version>
						<executions>
							<execution>
								<id>bundle-exe</id>
								<phase>package</phase>
								<goals>
									<goal>launch4j</goal>
								</goals>
								<configuration>
									<headerType>gui</headerType>
									<!-- the jar stays a normal file next to the exe, it is not wrapped -->
									<dontWrapJar>true</dontWrapJar>
									<jar>Launcher.jar</jar>
									<outfile>${bundle.windows.dir}/SokkerViewer.exe</outfile>
									<icon>${basedir}/src/main/resources/images/installSokkerViewer.ico</icon>
									<!-- SokkerViewer keeps its data next to the exe, so start there -->
									<chdir>.</chdir>
									<jre>
										<path>runtime</path>
										<requiresJdk>false</requiresJdk>
									</jre>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				  <version>3.11.0</version>
				  <configuration>
					<source>8</source>
					<target>8</target>
				  </configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-dependencies</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>target</outputDirectory>
							<includeScope>compile</includeScope>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>1.1</version>
				<executions>
					<execution>
						<id>buildSV</id>
						<phase>compile</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<tasks>
								<ant inheritRefs="true" antfile="${basedir}/build.xml">
									<property value="${sv.os.type}" name="os.name.value" />
									<property name="lib.src.dir" value="target/" />
									<property name="swt"
										value="${swt.os-specific-dep}-${swt.version}.jar" />
									<target name="post_clean" />
								</ant>
							</tasks>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>